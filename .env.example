# Copy this file to .env
NODE_ENV=development
PORT=3000

# Database - Local MySQL (XAMPP):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gym_db
DB_SSL=false
DB_TIMEZONE=+08:00

# Database - Cloud MySQL (Aiven):
# DB_HOST=mysql-xxxx.aivencloud.com
# DB_PORT=21016
# DB_USER=avnadmin
# DB_PASSWORD=your-password
# DB_NAME=defaultdb
# DB_SSL=true
# DB_SSL_CA_FILE=certs/ca.pem
# (On Render without file upload, paste the CA text into DB_SSL_CA instead of DB_SSL_CA_FILE)

# Long random text (at least 16 characters) that signs the login cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
